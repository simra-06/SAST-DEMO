pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {

        stage('Build') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    bat '''
                        mvn verify sonar:sonar ^
                        -Dsonar.projectKey=sast-demo ^
                        -Dsonar.projectName=SAST-Demo
                    '''
                }
            }
        }
    }
}
